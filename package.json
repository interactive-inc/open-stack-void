{
  "name": "open-stack-void",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vp run -r build",
    "preview": "vp -C apps/app preview",
    "fmt": "vp fmt",
    "lint": "vp lint --deny-warnings",
    "check": "vp run -r check",
    "test": "vp run -r test",
    "setup": "node scripts/setup.mjs",
    "test:e2e": "playwright test",
    "test:e2e:portless": "playwright test --config playwright.portless.config.ts",
    "seed:site": "node scripts/seed-site.mjs",
    "test:e2e:cms": "playwright test --config playwright.cms.config.ts",
    "check:dependencies": "node scripts/check-lock-age.mjs",
    "test:policy": "node --test scripts/release-policy.test.mjs",
    "prepare:local": "node scripts/prepare-local.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:harness": "node --test scripts/architecture-policy.test.mjs scripts/docs-policy.test.mjs scripts/release-candidate.test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full",
    "release:plan": "node scripts/release-plan.mjs",
    "setup:scanner": "node scripts/setup-scanner.mjs"
  },
  "devDependencies": {
    "@babel/parser": "7.29.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "oxc-transform-react": "0.152.0",
    "portless": "0.15.11",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "oxc-transform-react": "$oxc-transform-react",
    "undici@^7": "7.30.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "^24.21.0 || >=26.0.0",
    "npm": "12.2.1"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": true,
    "sharp": true,
    "workerd": true
  }
}
